# Quorum refuses to guess an AWS region. Set this only to a region enabled for your account.
QUORUM_AWS_REGION=

# Fail-closed cost gate. Keep false except during a deliberately bounded model run.
QUORUM_BEDROCK_ENABLED=false

# Optional override. The default is documented in src/quorum/orchestration.py.
QUORUM_BEDROCK_MODEL_ID=

# Caps output per model call; accepted range is 64-1024. This is not an AWS billing hard limit.
QUORUM_BEDROCK_MAX_TOKENS=384

# AgentCore Memory ID provisioned with quorum-provision-memory.
QUORUM_AGENTCORE_MEMORY_ID=

# IAM-authenticated AgentCore Gateway MCP endpoint, including the /mcp path.
QUORUM_AGENTCORE_GATEWAY_URL=

# Independent fail-closed switch for Gateway Lambda side effects. MCP tools/list works while false,
# but every tools/call is rejected before database, Slack, or Google clients are initialized.
QUORUM_EXECUTION_ENABLED=false

# Local default: sqlite+pysqlite:///./var/quorum.sqlite3
# Production example only; inject the real secret through the deployment environment.
# QUORUM_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/quorum?sslmode=require
QUORUM_DATABASE_URL=

# Required for signed, single-use undo links. Use at least 32 random bytes and inject it as a secret.
QUORUM_UNDO_SIGNING_SECRET=

# Public HTTPS origin used to build undo URLs, without a trailing slash.
QUORUM_PUBLIC_BASE_URL=

# Required only when Slack delivery is enabled. Never commit a real xoxb token.
QUORUM_SLACK_BOT_TOKEN=

# Test-workspace IDs used only by the explicit quorum-slack-smoke live-post command.
QUORUM_SLACK_DEMO_CHANNEL_ID=
QUORUM_SLACK_DEMO_PARTICIPANT_ID=

# Required for Slack Events API request verification. Inject as a secret.
QUORUM_SLACK_SIGNING_SECRET=

# Separate secret used only for deterministic Slack ID pseudonymization.
QUORUM_SLACK_PSEUDONYM_KEY=

# Google Workspace adapters use Application Default Credentials with the scopes documented in
# Method.md. Configure ADC outside this file; do not commit credential JSON.
